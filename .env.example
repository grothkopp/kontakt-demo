# Copy to .env. Never commit real keys. Offline is the safe default.
AI_PROVIDER=fake
AI_PROMPT=p2
# Required for live mode: use an exact model ID available in your API project.
AI_MODEL=
OPENAI_API_KEY=
# Optional; use only a reasoning setting supported by that model.
AI_REASONING_EFFORT=

# Optional Langfuse Cloud; keys belong to the same project and region.
DEMO_TRACING=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Only enable for fictional workshop notes. Real notes may contain personal data.
DEMO_CAPTURE_CONTENT=0
